# Copy to .env.local (gitignored) and fill in. Also add the same variables in Vercel → Settings → Environment Variables.
# Azure Speech (neural French voice for "read aloud"). Without a key the app uses the phone's own voice.
EXPO_PUBLIC_AZURE_SPEECH_KEY=
EXPO_PUBLIC_AZURE_SPEECH_REGION=westeurope
# Other French voices e.g. fr-FR-HenriNeural, fr-FR-VivienneMultilingualNeural
EXPO_PUBLIC_AZURE_SPEECH_VOICE=fr-FR-DeniseNeural
# DeepL (free-text translation in the staff chat). Server side only, no EXPO_PUBLIC_ prefix: the key stays out of the app.
# Free keys end in ":fx". Used by the dev server (metro.config.js) and the Vercel function (api/translate.js).
DEEPL_API_KEY=
